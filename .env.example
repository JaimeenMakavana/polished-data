# Optional. Copy this file to `.env` and fill only what you need.
# The agent and job scripts work without any of these set.

# HTTP client
# POLISHED_DATA_USER_AGENT=polished-data/0.1 (+https://github.com/JaimeenMakavana/polished-data)
# POLISHED_DATA_REQUEST_TIMEOUT_SECONDS=30
# POLISHED_DATA_RATE_LIMIT_RPS=1

# Geocoding (Photon/OSM by default; override if you self-host)
# PHOTON_URL=https://photon.komoot.io/api/

# GitHub API — optional, only for higher rate limits during tool discovery
# GITHUB_TOKEN=

# Never commit `.env`. See config/default.yaml for non-secret defaults.
